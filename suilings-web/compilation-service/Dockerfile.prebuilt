# Dockerfile using official suiup installer
# Fast and reliable - installs latest stable Sui

FROM node:18-slim

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install Sui using official suiup installer
RUN curl -sSfL https://raw.githubusercontent.com/MystenLabs/suiup/main/install.sh | sh

# Copy Sui binary to global location so non-root user can access it
RUN cp /root/.sui/bin/sui /usr/local/bin/sui && chmod +x /usr/local/bin/sui

# Verify Sui installation
RUN sui --version

# Create app directory
WORKDIR /app

# Create non-root user
RUN useradd -m -u 1001 appuser

# Copy package files
COPY suilings-web/compilation-service/package*.json ./

# Install dependencies
RUN npm ci --only=production && \
    npm cache clean --force

# Copy application code
COPY suilings-web/compilation-service/server.js ./

# Copy runner-crate (at same level as suilings-web)
COPY runner-crate ./runner-crate

# Change ownership to non-root user
RUN chown -R appuser:appuser /app

# Switch to non-root user
USER appuser

# Expose port
EXPOSE 3001

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD node -e "require('http').get('http://localhost:3001/health', (r) => {process.exit(r.statusCode === 200 ? 0 : 1)})"

# Start server
CMD ["npm", "start"]

