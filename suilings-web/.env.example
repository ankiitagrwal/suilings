# Copy this to .env.local and add your values

# OpenAI API Key (REQUIRED for AI Assistant)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# Supabase Configuration
# Get from: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Gemini API Key (REQUIRED for AI features)
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Google Form URL for feedback (optional)
NEXT_PUBLIC_GOOGLE_FORM_URL=https://forms.gle/your-form-id

# Move Compilation Backend
# Deploy the compilation service and add its URL here
COMPILATION_BACKEND_URL=http://your-compilation-service-url:3006

# Sui Network Configuration
SUI_NETWORK=testnet
SUI_RPC_URL=https://sui-testnet-rpc.publicnode.com

# Credential Smart Contract (from deployment)
# Deploy the contract first and add the IDs here
CREDENTIAL_PACKAGE_ID=0x_your_package_id
CREDENTIAL_ADMIN_CAP_ID=0x_your_admin_cap_id
CREDENTIAL_REGISTRY_ID=0x_your_registry_id

# Admin Wallet (for minting credentials)
# Use 'sui keytool export' to get your private key
ADMIN_WALLET_PRIVATE_KEY=suiprivkey1_your_private_key_here
ADMIN_WALLET_ADDRESS=0x_your_wallet_address
