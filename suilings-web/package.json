{
  "name": "suilings-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/generate-exercises-json.js && next dev --webpack",
    "dev:watch": "npm-run-all --parallel dev:exercises dev:next",
    "dev:exercises": "nodemon --watch ../exercises --ext move,toml -x 'node scripts/generate-exercises-json.js'",
    "dev:next": "next dev --webpack",
    "prebuild": "node scripts/generate-exercises-json.js",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "seed:exercises": "tsx scripts/seed-exercises.ts"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
